<odoo>
    <record id="view_form_barang" model="ir.ui.view">
        <field name="name">gadai.barang.form</field>
        <field name="model">gadai.barang</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="jenis"/>
                        <field name="nilai_taksiran"/>
                        <field name="transaksi_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_barang" model="ir.ui.view">
        <field name="name">gadai.barang.tree</field>
        <field name="model">gadai.barang</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="jenis"/>
                <field name="nilai_taksiran"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_barang" name="Barang" parent="menu_gadai_root"/>
    <record id="action_barang" model="ir.actions.act_window">
        <field name="name">Barang</field>
        <field name="res_model">gadai.barang</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_barang_action" name="Data Barang" parent="menu_barang" action="action_barang"/>
</odoo>
