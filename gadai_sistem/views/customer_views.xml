<odoo>
    <record id="view_form_customer" model="ir.ui.view">
        <field name="name">gadai.customer.form</field>
        <field name="model">gadai.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="nik"/>
                        <field name="phone"/>
                        <field name="phone2"/>
                        <field name="address"/>
                    </group>
                    <notebook>
                        <page string="Transaksi">
                            <field name="transaksi_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="tanggal"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_customer" model="ir.ui.view">
        <field name="name">gadai.customer.tree</field>
        <field name="model">gadai.customer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <menuitem id="menu_gadai_root" name="Pegadaian"/>
    <menuitem id="menu_customer" name="Customer" parent="menu_gadai_root" action="action_customer"/>
    <record id="action_customer" model="ir.actions.act_window">
        <field name="name">Customer</field>
        <field name="res_model">gadai.customer</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
