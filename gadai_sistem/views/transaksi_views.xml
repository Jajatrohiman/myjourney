<odoo>
    <record id="view_form_transaksi" model="ir.ui.view">
        <field name="name">gadai.transaksi</field>
        <field name="model">gadai.transaksi</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_tandai_lunas" type="object" string="Tandai Lunas" class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'aktif')]}"/>
                    <button name="action_perpanjang" type="object" string="Perpanjang" class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'aktif')]}"/>
                    <button name="action_tandai_lelang" type="object" string="Lelang" class="btn-danger"
                        attrs="{'invisible': [('state', '!=', 'aktif')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="aktif,lunas,diperpanjang,dilelang"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="customer_id"/>
                            <field name="tanggal"/>
                            <field name="durasi_hari"/>
                            <field name="jatuh_tempo"/>
                        </group>
                        <group>
                            <field name="nilai_taksiran"/>
                            <field name="jumlah_pinjaman"/>
                            <field name="bunga_persen"/>
                            <field name="total_bunga" force_save="1"/>
                            <field name="total_pelunasan" force_save="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Barang Gadai">
                            <field name="barang_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="jenis"/>
                                    <field name="nilai_taksiran"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group string="Informasi Pelunasan">
                        <group>
                            <field name="is_lunas"/>
                            <field name="tanggal_lunas" attrs="{'invisible': [('is_lunas', '=', False)]}"/>
                            <field name="nominal_pelunasan" attrs="{'readonly': [('state', '=', 'lunas')], 'required': [('is_lunas', '=', True)]}"/>
                        </group>
                        <group>
                            <field name="selisih_pelunasan" attrs="{'invisible': [('is_lunas', '=', False)]}" 
                                   widget="monetary" options="{'currency_field': 'currency_id'}" 
                                   decoration-danger="selisih_pelunasan &lt; 0" 
                                   decoration-info="selisih_pelunasan &gt; 0"/>
                            <field name="catatan_pelunasan" placeholder="Catatan tentang pelunasan (misal: alasan diskon/potongan)"/>
                        </group>
                    </group>
                    <group string="Perpanjangan" attrs="{'invisible': [('transaksi_asal_id', '=', False)]}">
                        <field name="transaksi_asal_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_transaksi" model="ir.ui.view">
        <field name="name">gadai.transaksi.tree</field>
        <field name="model">gadai.transaksi</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="tanggal"/>
                <field name="jatuh_tempo"/>
                <field name="jumlah_pinjaman"/>
                <field name="total_bunga"/>
                <field name="total_pelunasan"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
</odoo>